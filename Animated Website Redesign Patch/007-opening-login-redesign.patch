diff --git a/apps/web/app/globals.css b/apps/web/app/globals.css
index 2bc1ca3..7661829 100644
--- a/apps/web/app/globals.css
+++ b/apps/web/app/globals.css
@@ -293,3 +293,129 @@ a:focus-visible, button:focus-visible, input:focus-visible, select:focus-visible
 @media (prefers-reduced-motion: reduce) {
   *, *::before, *::after { scroll-behavior: auto !important; animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }
 }
+
+/* Opening, workspace gate, and operations redesign */
+.opening-screen, .login-screen {
+  --night: #05090d;
+  --panel: #0b1218;
+  --acid: #b9f64b;
+  --cyan: #67e8f9;
+  min-height: 100svh;
+  background: var(--night);
+  color: #f5f7f8;
+}
+.opening-screen { position: relative; display: grid; overflow: hidden; place-items: center; padding: 48px 24px; }
+.opening-grid, .login-grid { position: absolute; inset: 0; background-image: linear-gradient(#ffffff08 1px, transparent 1px), linear-gradient(90deg, #ffffff08 1px, transparent 1px); background-size: 64px 64px; mask-image: linear-gradient(to bottom, #000 15%, transparent 88%); }
+.opening-screen::after { position: absolute; right: 4vw; bottom: -18vw; width: 52vw; height: 52vw; border: 1px solid #b9f64b12; border-radius: 50%; box-shadow: 0 0 0 9vw #b9f64b05, 0 0 0 18vw #b9f64b03; content: ""; }
+.opening-glow { position: absolute; border-radius: 50%; filter: blur(110px); opacity: .16; }
+.opening-glow-one { top: -16%; left: -8%; width: 42vw; height: 42vw; background: #2ad7d0; }
+.opening-glow-two { right: 3%; bottom: -10%; width: 35vw; height: 35vw; background: var(--acid); }
+.skip-opening { position: absolute; z-index: 3; top: 28px; right: 34px; padding: 9px 13px; border: 1px solid #ffffff1c; border-radius: 999px; background: #ffffff08; color: #a9b2b8; font-size: 11px; letter-spacing: .08em; text-transform: uppercase; transition: border-color .2s, color .2s; }
+.skip-opening:hover { border-color: #b9f64b55; color: #fff; }
+.opening-content { position: relative; z-index: 2; width: min(720px, 100%); text-align: center; animation: openingReveal .9s cubic-bezier(.2,.8,.2,1) both; }
+.opening-orbit { position: relative; display: grid; width: 132px; height: 132px; margin: 0 auto 36px; place-items: center; }
+.orbit-ring { position: absolute; inset: 0; border: 1px solid #b9f64b38; border-radius: 50%; }
+.orbit-ring::before { position: absolute; top: -4px; left: calc(50% - 4px); width: 8px; height: 8px; border-radius: 50%; background: var(--acid); box-shadow: 0 0 18px var(--acid); content: ""; }
+.orbit-ring-one { animation: orbit 4s linear infinite; }
+.orbit-ring-two { inset: 13px; border-style: dashed; border-color: #67e8f938; animation: orbit 6s linear infinite reverse; }
+.opening-brand-mark { display: grid; width: 78px; height: 78px; place-items: center; border: 1px solid #ffffff20; border-radius: 22px; background: linear-gradient(145deg, #182329, #080d11); box-shadow: inset 0 1px #ffffff16, 0 22px 60px #000; color: var(--acid); font-size: 24px; font-weight: 800; letter-spacing: -.08em; }
+.opening-kicker { display: flex; align-items: center; justify-content: center; gap: 9px; margin: 0 0 18px; color: #8d999f; font-size: 10px; font-weight: 700; letter-spacing: .22em; text-transform: uppercase; }
+.opening-kicker span { width: 6px; height: 6px; border-radius: 50%; background: var(--acid); box-shadow: 0 0 12px var(--acid); }
+.opening-title { margin: 0; color: #f3f6f7; font: 650 clamp(42px, 6vw, 78px)/.98 "Segoe UI", Arial, sans-serif; letter-spacing: -.055em; }
+.opening-title em { color: var(--acid); font-style: normal; }
+.opening-copy { margin: 24px 0 32px; color: #839098; font-size: 14px; }
+.opening-progress { width: min(390px, 82%); height: 2px; margin: 0 auto 12px; overflow: hidden; background: #ffffff12; }
+.opening-progress-bar { display: block; width: 100%; height: 100%; transform-origin: left; background: linear-gradient(90deg, var(--acid), var(--cyan)); box-shadow: 0 0 14px var(--acid); animation: loadProgress 3.7s cubic-bezier(.3,.1,.2,1) both; }
+.opening-status { display: flex; width: min(390px, 82%); justify-content: space-between; margin: auto; color: #4f5b61; font-size: 8px; font-weight: 700; letter-spacing: .16em; }
+.opening-status-value { color: #87943e; }
+
+.login-screen { display: grid; grid-template-columns: minmax(420px, 1.08fr) minmax(440px, .92fr); }
+.login-visual { position: relative; min-height: 100svh; overflow: hidden; background: radial-gradient(circle at 20% 14%, #1d4f4d55, transparent 38%), radial-gradient(circle at 78% 78%, #9ac83b22, transparent 34%), #060b0f; }
+.login-visual::after { position: absolute; right: -24%; bottom: -34%; width: 82%; aspect-ratio: 1; border: 1px solid #b9f64b2b; border-radius: 50%; box-shadow: 0 0 0 80px #b9f64b08, 0 0 0 160px #b9f64b05; content: ""; }
+.login-visual-content { position: relative; z-index: 2; display: flex; min-height: 100%; flex-direction: column; padding: clamp(36px, 5vw, 70px); }
+.login-wordmark, .mobile-wordmark { display: flex; align-items: center; gap: 12px; color: #869198; font-size: 10px; font-weight: 700; letter-spacing: .19em; }
+.login-wordmark span, .mobile-wordmark span { display: grid; width: 43px; height: 43px; place-items: center; border-radius: 12px; background: var(--acid); color: #071006; font-size: 13px; font-weight: 900; letter-spacing: -.05em; }
+.login-message { margin: auto 0; }
+.login-message > p { margin: 0 0 18px; color: var(--acid); font-size: 9px; font-weight: 700; letter-spacing: .22em; }
+.login-message h1 { margin: 0 0 44px; color: #f4f6f6; font: 600 clamp(42px, 5vw, 68px)/1.04 "Segoe UI", Arial, sans-serif; letter-spacing: -.055em; }
+.login-feature { display: flex; max-width: 440px; gap: 15px; margin-top: 22px; color: var(--acid); }
+.login-feature span { color: #77838a; font-size: 12px; line-height: 1.5; }
+.login-feature b { display: block; margin-bottom: 2px; color: #dce2e4; font-size: 12px; }
+.login-visual-footer { display: flex; align-items: center; gap: 8px; color: #5b666c; font-size: 8px; font-weight: 700; letter-spacing: .16em; }
+.login-visual-footer b { margin-left: auto; font-weight: 600; }
+.live-signal { width: 6px; height: 6px; border-radius: 50%; background: var(--acid); box-shadow: 0 0 10px var(--acid); }
+.login-panel { display: flex; min-height: 100svh; flex-direction: column; background: #f2f3ef; color: #11191c; }
+.mobile-wordmark { display: none; }
+.login-form-wrap { width: min(390px, calc(100% - 56px)); margin: auto; padding: 48px 0; animation: openingReveal .65s ease-out both; }
+.login-icon { display: grid; width: 46px; height: 46px; place-items: center; border-radius: 14px; background: #e1e6d9; color: #34441f; }
+.login-kicker { margin: 30px 0 10px; color: #6d7d51; font-size: 9px; font-weight: 800; letter-spacing: .18em; }
+.login-form-wrap h2 { margin: 0; color: #11191c; font: 650 36px/1.15 "Segoe UI", Arial, sans-serif; letter-spacing: -.04em; }
+.login-subtitle { margin: 12px 0 35px; color: #7a8384; font-size: 13px; line-height: 1.6; }
+.login-form-wrap label { display: block; margin-bottom: 8px; color: #334044; font-size: 10px; font-weight: 700; letter-spacing: .03em; }
+.login-form-wrap input { width: 100%; height: 48px; padding: 0 14px; border: 1px solid #d6d9d2; border-radius: 8px; background: #fbfcfa; color: #142024; outline: none; transition: border-color .2s, box-shadow .2s; }
+.login-form-wrap input::placeholder { color: #a1a8a6; }
+.login-form-wrap input:focus { border-color: #7d9846; box-shadow: 0 0 0 3px #9cbd5a22; }
+.password-label { display: flex; align-items: start; justify-content: space-between; margin-top: 21px; }
+.password-label button { padding: 0; border: 0; background: none; color: #71824d; font-size: 9px; font-weight: 700; }
+.password-field { position: relative; }
+.password-field input { padding-right: 46px; }
+.password-field > button { position: absolute; top: 0; right: 0; display: grid; width: 46px; height: 48px; place-items: center; border: 0; background: transparent; color: #737d7e; }
+.login-error { margin: 10px 0 0; color: #b64a42; font-size: 10px; }
+.login-submit { display: flex; width: 100%; height: 49px; align-items: center; justify-content: center; gap: 10px; margin-top: 24px; border: 0; border-radius: 8px; background: #121c1f; box-shadow: 0 10px 24px #16222522; color: #f6f8f7; font-size: 11px; font-weight: 700; letter-spacing: .02em; transition: transform .2s, background .2s; }
+.login-submit:hover { transform: translateY(-1px); background: #243237; }
+.login-disclaimer { margin: 20px 0 0; padding: 12px 14px; border-left: 2px solid #a9bd7c; background: #e9ebe4; color: #78807a; font-size: 9px; line-height: 1.55; }
+.login-footer { display: flex; justify-content: space-between; padding: 24px 34px; color: #929995; font-size: 8px; letter-spacing: .04em; }
+
+.operations-shell { --ink: #dce5e8; --muted: #819097; --line: #1d2a30; --navy: #070c10; --blue: #b9f64b; --bg: #0b1115; --green: #91d9a2; --red: #ff8178; background: var(--bg); color: var(--ink); }
+.operations-shell .sidebar { border-right: 1px solid #182329; background: #070c10; }
+.operations-shell .brand-mark { background: var(--blue); box-shadow: 0 5px 24px #b9f64b22; color: #071006; }
+.operations-shell .nav-item.active { background: #b9f64b12; color: #e9efef; }
+.operations-shell .nav-item.active > span:first-child { color: var(--blue); }
+.operations-shell .content { background: radial-gradient(circle at 85% 0, #263a252e, transparent 30%), var(--bg); }
+.operations-shell .topbar { border-color: var(--line); background: #0b1115e8; }
+.operations-shell .breadcrumbs b, .operations-shell h1, .operations-shell .section-heading h2, .operations-shell .card h2, .operations-shell .metric-value, .operations-shell .severity-total strong { color: #e8edef; }
+.operations-shell .env-pill { border-color: #2a3738; background: #151f20; color: #a7b5af; }
+.operations-shell .env-pill i { background: var(--blue); }
+.operations-shell .page-wrap { padding-top: 38px; }
+.operations-shell .eyebrow { color: #819087; }
+.operations-shell h1 { font-size: 31px; }
+.operations-shell .primary-button { background: var(--blue); box-shadow: 0 7px 20px #b9f64b16; color: #0a1009; }
+.operations-shell .primary-button:hover:not(:disabled) { background: #c9ff67; }
+.operations-shell .scan-target-select select, .operations-shell .target-form input, .operations-shell .target-form select { border-color: #26343a; background: #10191e; color: #cbd5d8; }
+.operations-shell .metric-card, .operations-shell .card { border-color: var(--line); background: linear-gradient(145deg, #10181d, #0d1418); box-shadow: 0 14px 35px #00000018; }
+.operations-shell .metric-card { border-radius: 13px; }
+.operations-shell .metric-icon.blue, .operations-shell .metric-icon.green { background: #b9f64b12; color: var(--blue); }
+.operations-shell .metric-icon.red { background: #ff817812; color: #ff8178; }
+.operations-shell .metric-icon.violet { background: #a78bfa12; color: #b9a3ff; }
+.operations-shell .metric-accent.blue, .operations-shell .metric-accent.green { background: var(--blue); }
+.operations-shell .card { border-radius: 13px; }
+.operations-shell th { border-color: #202d33; background: #0b1216; color: #6f7e85; }
+.operations-shell td, .operations-shell .scan-row, .operations-shell .target-row, .operations-shell .change-row { border-color: #1c282e; }
+.operations-shell .finding-title, .operations-shell .target-name, .operations-shell .scan-info b, .operations-shell .target-info b, .operations-shell .change-info b { color: #c9d2d5; }
+.operations-shell .refresh-button { border-color: #28363c; background: #10191e; color: #8fa0a7; }
+.operations-shell .target-form { border-color: #233138; background: #0b1216; }
+.operations-shell .scope-note { background: #111d1f; color: #83a29b; }
+.operations-shell .import-button { border-color: #2a393f; color: #8fa4ad; }
+.operations-shell footer { border-top: 1px solid #182329; padding-top: 18px; }
+
+@keyframes openingReveal { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: translateY(0); } }
+@keyframes orbit { to { transform: rotate(360deg); } }
+@keyframes loadProgress { from { transform: scaleX(0); } to { transform: scaleX(1); } }
+
+@media (max-width: 900px) {
+  .login-screen { grid-template-columns: 1fr; }
+  .login-visual { display: none; }
+  .mobile-wordmark { display: flex; margin: 28px 28px 0; }
+  .login-panel { min-height: 100svh; }
+}
+@media (max-width: 560px) {
+  .opening-title { font-size: 42px; }
+  .opening-orbit { width: 108px; height: 108px; margin-bottom: 28px; }
+  .opening-brand-mark { width: 66px; height: 66px; border-radius: 19px; font-size: 21px; }
+  .skip-opening { top: 18px; right: 18px; }
+  .login-form-wrap { width: calc(100% - 40px); padding: 40px 0 24px; }
+  .login-footer { padding: 20px; }
+}
+@media (prefers-reduced-motion: reduce) {
+  .orbit-ring, .opening-progress-bar, .opening-content, .login-form-wrap { animation: none !important; }
+}
