+  async function toggleKillSwitch() {
+    const engaging = !data.safety.kill_switch_engaged;
+    try {
+      const response = await fetch(`${API}/api/safety/kill-switch`, { method: "POST", headers: { "Content-Type": "application/json" },
+        body: JSON.stringify({ engaged: engaging, reason: engaging ? "Manually halted from the dashboard." : "" }) });
+      if (!response.ok) throw new Error("Could not update the kill switch.");
+    } catch (err) { setError(err instanceof Error ? err.message : "Could not update the kill switch."); }
+  }
+
